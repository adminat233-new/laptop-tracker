<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/panel">

        <LinearLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/icon_bg"
            android:gravity="center"
            android:layout_marginEnd="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="F"
                android:textColor="#000"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FIND"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/mainStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Offline"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:background="@drawable/card_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- MAP -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- MAP TYPE CONTROLS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="@color/panel"
        android:gravity="center">

        <Button
            android:id="@+id/btnMapStreet"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/btn_bg"
            android:text="🗺️ Street"
            android:textColor="#000"
            android:textSize="10sp"
            android:textStyle="bold"
            android:onClick="onMapStreetClick" />

        <Button
            android:id="@+id/btnMapSatellite"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/tool_bg"
            android:text="🛰️ Satellite"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:onClick="onMapSatelliteClick" />

        <Button
            android:id="@+id/btnMapTerrain"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/tool_bg"
            android:text="🏔️ Terrain"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:onClick="onMapTerrainClick" />
    </LinearLayout>

    <!-- TRACK INFO BAR -->
    <LinearLayout
        android:id="@+id/trackInfo"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/panel"
        android:paddingHorizontal="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/trackDist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="---"
            android:layout_marginEnd="16dp" />
        <TextView
            android:id="@+id/trackBearing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:text="---" />
    </LinearLayout>

    <!-- SCROLL CONTENT BELOW MAP -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        android:background="@color/bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- STATUS CARDS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="10dp"
                    android:layout_marginEnd="6dp">

                    <TextView android:id="@+id/lpName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💻 Laptop" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/lpOs" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="OS: --" android:textColor="@color/muted" android:textSize="10sp" android:layout_marginTop="2dp"/>
                    <TextView android:id="@+id/lpCoords" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Coords: --" android:textColor="@color/muted" android:textSize="10sp"
                        android:fontFamily="monospace"/>
                    <TextView android:id="@+id/lpAcc" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Accuracy: --" android:textColor="@color/muted" android:textSize="10sp"/>
                    <TextView android:id="@+id/agentStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Agent: checking..." android:textColor="@color/muted" android:textSize="10sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="10dp"
                    android:layout_marginStart="6dp">

                    <TextView android:id="@+id/phName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📱 Phone" android:textColor="#00D4FF" android:textSize="12sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/phCoords" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Coords: --" android:textColor="@color/muted" android:textSize="10sp"
                        android:fontFamily="monospace" android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- TOOL BUTTONS -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:layout_marginBottom="10dp">

                <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                    android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="📍 Locate" android:textColor="@color/accent" android:textSize="9sp" android:textStyle="bold"
                    android:onClick="onLocateClick"/>
                <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                    android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="📶 WiFi" android:textColor="#FFF" android:textSize="9sp"
                    android:onClick="onWifiClick"/>
                <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                    android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="🔍 ARP" android:textColor="#FFF" android:textSize="9sp"
                    android:onClick="onArpClick"/>
                <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                    android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="🔵 BT" android:textColor="#FFF" android:textSize="9sp"
                    android:onClick="onBtClick"/>

                <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                    android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="📸 Screen" android:textColor="#FFF" android:textSize="9sp"
                    android:onClick="onScreenshotClick"/>
                <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                    android:layout_margin="2dp" android:background="@drawable/danger_bg" android:text="🚨 Siren" android:textColor="@color/red" android:textSize="9sp"
                    android:onClick="onSirenClick"/>
                <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                    android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="🔒 Lock" android:textColor="#FFF" android:textSize="9sp"
                    android:onClick="onLockClick"/>
                <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                    android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="🌐 DNS" android:textColor="#FFF" android:textSize="9sp"
                    android:onClick="onDnsClick"/>

                <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                    android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="🔍 Ports" android:textColor="#FFF" android:textSize="9sp"
                    android:onClick="onPortClick"/>
                <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                    android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="🔑 Pass" android:textColor="#FFF" android:textSize="9sp"
                    android:onClick="onPassClick"/>
                <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                    android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="💾 USB" android:textColor="#FFF" android:textSize="9sp"
                    android:onClick="onUsbClick"/>
                <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                    android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="⚙️ Procs" android:textColor="#FFF" android:textSize="9sp"
                    android:onClick="onProcClick"/>
            </GridLayout>

            <!-- FULL RECOVERY SCAN -->
            <Button
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/btn_bg"
                android:text="⚡ FULL RECOVERY SCAN"
                android:textColor="#000000"
                android:textStyle="bold"
                android:onClick="onFullRecoveryClick" />

            <!-- LOST / FOUND -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/markLostBtn"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/danger_bg"
                    android:text="🚨 MARK LOST"
                    android:textColor="@color/red"
                    android:textStyle="bold"
                    android:onClick="onMarkLostClick" />

                <Button
                    android:id="@+id/foundBtn"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/recovered_bg"
                    android:text="✅ RECOVERED"
                    android:textColor="@color/green"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:onClick="onRecoveredClick" />
            </LinearLayout>

            <!-- LOG -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="10dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Intel Stream"
                    android:textColor="@color/muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="120dp">
                    <LinearLayout
                        android:id="@+id/logBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>

            <TextView
                android:id="@+id/intelOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:background="@drawable/card_bg"
                android:padding="10dp"
                android:layout_marginBottom="6dp" />

            <!-- RE-PAIR -->
            <Button
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/tool_bg"
                android:text="🔄 Re-pair / Reset"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:onClick="onRePairClick" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
