<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0A">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#121212">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FIND"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mainStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Offline"
            android:textColor="#888888"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- MAP -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- TRACK INFO BAR -->
    <LinearLayout
        android:id="@+id/trackInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#121212"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/trackDist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#D4FF3F"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="---" />
    </LinearLayout>

    <!-- BOTTOM CONTROLS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#121212"
        android:padding="12dp">

        <!-- STATUS CARDS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="8dp"
                android:layout_marginEnd="4dp">

                <TextView android:id="@+id/lpName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="💻 Laptop" android:textColor="#FFF" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:id="@+id/lpCoords" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Coords: --" android:textColor="#888" android:textSize="9sp"
                    android:fontFamily="monospace"/>
                <TextView android:id="@+id/lpAcc" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Accuracy: --" android:textColor="#888" android:textSize="9sp"/>
                <TextView android:id="@+id/agentStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Agent: checking..." android:textColor="#888" android:textSize="9sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="8dp"
                android:layout_marginStart="4dp">

                <TextView android:id="@+id/phName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📱 Phone" android:textColor="#FFF" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:id="@+id/phCoords" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Coords: --" android:textColor="#888" android:textSize="9sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </LinearLayout>

        <!-- TOOL BUTTONS -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="4"
            android:layout_marginBottom="8dp">

            <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="📍 Locate" android:textColor="#FFF" android:textSize="10sp"
                android:onClick="onLocateClick"/>
            <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="📶 WiFi" android:textColor="#FFF" android:textSize="10sp"
                android:onClick="onWifiClick"/>
            <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="🔍 ARP" android:textColor="#FFF" android:textSize="10sp"
                android:onClick="onArpClick"/>
            <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="🔵 BT" android:textColor="#FFF" android:textSize="10sp"
                android:onClick="onBtClick"/>

            <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="📸 Screen" android:textColor="#FFF" android:textSize="10sp"
                android:onClick="onScreenshotClick"/>
            <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="🚨 Siren" android:textColor="#FF4444" android:textSize="10sp"
                android:onClick="onSirenClick"/>
            <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="🔒 Lock" android:textColor="#FFF" android:textSize="10sp"
                android:onClick="onLockClick"/>
            <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="🌐 DNS" android:textColor="#FFF" android:textSize="10sp"
                android:onClick="onDnsClick"/>

            <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="🔍 Ports" android:textColor="#FFF" android:textSize="10sp"
                android:onClick="onPortClick"/>
            <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="🔑 Pass" android:textColor="#FFF" android:textSize="10sp"
                android:onClick="onPassClick"/>
            <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="💾 USB" android:textColor="#FFF" android:textSize="10sp"
                android:onClick="onUsbClick"/>
            <Button android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1"
                android:layout_margin="2dp" android:background="@drawable/tool_bg" android:text="⚙️ Procs" android:textColor="#FFF" android:textSize="10sp"
                android:onClick="onProcClick"/>
        </GridLayout>

        <!-- LOST MODE -->
        <Button
            android:id="@+id/markLostBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/danger_bg"
            android:text="🚨 MARK LOST"
            android:textColor="#FF4444"
            android:textStyle="bold"
            android:onClick="onMarkLostClick" />

        <Button
            android:id="@+id/foundBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/recovered_bg"
            android:text="✅ RECOVERED"
            android:textColor="#00FF88"
            android:textStyle="bold"
            android:visibility="gone"
            android:onClick="onRecoveredClick" />

        <!-- LOG -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:background="#000000"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/logBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- RE-PAIR -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/tool_bg"
            android:text="🔄 Re-pair"
            android:textColor="#888888"
            android:textSize="11sp"
            android:onClick="onRePairClick" />

    </LinearLayout>
</LinearLayout>
