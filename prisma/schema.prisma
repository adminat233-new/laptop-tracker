generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Code {
  id         Int     @id @default(autoincrement())
  pairCode   String  @unique @map("pair_code") @db.VarChar(10)
  binaryCode String  @map("binary_code") @db.Text
  deviceId   String  @map("device_id") @db.VarChar(50)
  deviceInfo String? @map("device_info") @db.Text
  isPaired   Boolean @default(false) @map("is_paired")
  createdAt  BigInt  @map("created_at")
  pairedAt   BigInt? @map("paired_at")

  @@map("codes")
}

model Device {
  id         Int     @id @default(autoincrement())
  deviceId   String  @unique @map("device_id") @db.VarChar(50)
  pairCode   String  @map("pair_code") @db.VarChar(10)
  deviceType String? @map("device_type") @db.VarChar(10)
  systemInfo String? @map("system_info") @db.Text
  pathData   String? @map("path_data") @db.Text
  lastSeen   BigInt? @map("last_seen")
  createdAt  BigInt  @map("created_at")

  @@map("devices")
}

model Location {
  id         Int     @id @default(autoincrement())
  deviceId   String  @unique @map("device_id") @db.VarChar(50)
  lat        Float?
  lng        Float?
  accuracy   Float?
  source     String? @db.VarChar(50)
  rssi       Int?
  confidence Int?
  updatedAt  BigInt  @map("updated_at")

  @@map("locations")
}

model Log {
  id        Int     @id @default(autoincrement())
  deviceId  String  @map("device_id") @db.VarChar(50)
  tool      String  @db.VarChar(50)
  output    String  @db.Text
  influence Float?  @default(0)
  level     String? @default("info") @db.VarChar(10)
  createdAt BigInt  @map("created_at")

  @@index([deviceId])
  @@map("logs")
}

model SignalReliability {
  id          Int     @id @default(autoincrement())
  identifier  String  @unique @db.VarChar(100) // MAC or BSSID
  reliability Float   @default(0.5)
  hitCount    Int     @default(0) @map("hit_count")
  lastSeen    BigInt  @map("last_seen")

  @@map("signal_reliability")
}

model Command {
  id          Int     @id @default(autoincrement())
  commandId   String  @unique @map("command_id") @db.VarChar(50)
  deviceId    String  @map("device_id") @db.VarChar(50)
  commandType String  @map("command_type") @db.VarChar(20)
  params      String? @db.Text
  result      String? @db.Text
  status      String? @default("pending") @db.VarChar(20)
  createdAt   BigInt  @map("created_at")
  completedAt BigInt? @map("completed_at")

  @@map("commands")
}

model Sale {
  id        Int      @id @default(autoincrement())
  pairCode  String   @map("pair_code") @db.VarChar(10)
  total     Float
  time      BigInt
  details   String?  @db.Text

  @@index([pairCode])
  @@map("sales")
}

model Product {
  id        Int      @id @default(autoincrement())
  pairCode  String   @map("pair_code") @db.VarChar(10)
  name      String   @db.VarChar(100)
  price     Float
  stock     Int      @default(0)

  @@index([pairCode])
  @@map("products")
}
