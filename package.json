{
  "name": "laptop-tracker",
  "version": "2.0.0",
  "description": "Laptop tracking with real hardware control via cloud relay",
  "scripts": {
    "start": "node cloud-server.js",
    "server": "node cloud-server.js",
    "agent": "node agent.js",
    "local": "node server.js",
    "postinstall": "prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:studio": "npx prisma studio",
    "db:generate": "npx prisma generate"
  },
  "engines": {
    "node": ">=18.x"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "prisma": "^6.19.3"
  }
}
